{
  "schema_version": "1.0",
  "px4_version_min": "1.15",
  "description": "PX4 多旋翼 Rate PID 调参知识库 — MC_*RATE_* 参数体系",

  "kb_caveat": "本 KB 数值并非 PX4 官方文档直接给出的量化阈值。PX4 官方 pid_tuning_guide_multicopter 仅描述症状级判据：'vehicle should immediately follow the command, and neither oscillate, nor overshoot (it feels locked-in)'。thresholds 字段由控制理论反推 + 调参经验 + 社区共识综合得出，可作为参考但非官方标准。pid_bounds 范围 (P 0.01-0.5, I 0.01-0.6, D 0.0004-0.005)、typical 值与调参顺序 (P+D → I) 与 PX4 main 官方文档一致。",

  "axis": ["roll", "pitch", "yaw"],

  "pid_bounds": {
    "p":  [0.01, 0.5],
    "i":  [0.01, 0.6],
    "d":  [0.0, 0.005],
    "ff": [0.0, 1.0]
  },

  "settle_band": 0.10,

  "thresholds": {
    "rise_time_ms": {
      "roll":  {"ideal": [60, 110], "acceptable": [40, 160], "unit": "ms"},
      "pitch": {"ideal": [60, 110], "acceptable": [40, 160], "unit": "ms"},
      "yaw":   {"ideal": [100, 200], "acceptable": [80, 300], "unit": "ms"}
    },
    "overshoot_percent": {
      "roll":  {"ideal": [0, 10], "acceptable": [0, 15], "marginal": [15, 25], "critical": [25, 100], "unit": "%"},
      "pitch": {"ideal": [0, 10], "acceptable": [0, 15], "marginal": [15, 25], "critical": [25, 100], "unit": "%"},
      "yaw":   {"ideal": [0, 10], "acceptable": [0, 20], "marginal": [20, 30], "critical": [30, 100], "unit": "%"}
    },
    "settling_time_ms": {
      "roll":  {"ideal": [150, 350], "acceptable": [100, 600], "marginal": [600, 1000], "critical": [1000], "unit": "ms"},
      "pitch": {"ideal": [150, 350], "acceptable": [100, 600], "marginal": [600, 1000], "critical": [1000], "unit": "ms"},
      "yaw":   {"ideal": [200, 500], "acceptable": [150, 800], "marginal": [800, 1500], "critical": [1500], "unit": "ms"}
    },
    "oscillation_count": {
      "roll":  {"ideal": [0, 0], "acceptable": [0, 1], "marginal": [1, 2], "critical": [2], "unit": "count"},
      "pitch": {"ideal": [0, 0], "acceptable": [0, 1], "marginal": [1, 2], "critical": [2], "unit": "count"},
      "yaw":   {"ideal": [0, 1], "acceptable": [0, 2], "marginal": [2, 3], "critical": [3], "unit": "count"}
    },
    "ss_error_percent": {
      "roll":  {"ideal": [0, 2], "acceptable": [0, 5], "marginal": [5, 10], "critical": [10], "unit": "%"},
      "pitch": {"ideal": [0, 2], "acceptable": [0, 5], "marginal": [5, 10], "critical": [10], "unit": "%"},
      "yaw":   {"ideal": [0, 3], "acceptable": [0, 8], "marginal": [8, 15], "critical": [15], "unit": "%"}
    }
  },

  "tuning_rules": {
    "default_pid_ranges": {
      "MC_ROLLRATE_P":  {"min": 0.01, "max": 0.5,  "typical": 0.15,  "unit": "gain"},
      "MC_ROLLRATE_I":  {"min": 0.01, "max": 0.6,  "typical": 0.3,   "unit": "gain"},
      "MC_ROLLRATE_D":  {"min": 0.0,  "max": 0.005,"typical": 0.003, "unit": "gain"},
      "MC_ROLLRATE_K":  {"min": 0.5,  "max": 2.0,  "typical": 1.0,   "unit": "gain"},
      "MC_PITCHRATE_P": {"min": 0.01, "max": 0.6,  "typical": 0.15,  "unit": "gain"},
      "MC_PITCHRATE_I": {"min": 0.01, "max": 0.6,  "typical": 0.3,   "unit": "gain"},
      "MC_PITCHRATE_D": {"min": 0.0,  "max": 0.005,"typical": 0.003, "unit": "gain"},
      "MC_PITCHRATE_K": {"min": 0.5,  "max": 2.0,  "typical": 1.0,   "unit": "gain"},
      "MC_YAWRATE_P":   {"min": 0.05, "max": 0.6,  "typical": 0.2,   "unit": "gain"},
      "MC_YAWRATE_I":   {"min": 0.01, "max": 0.4,  "typical": 0.1,   "unit": "gain"},
      "MC_YAWRATE_D":   {"min": 0.0,  "max": 0.005,"typical": 0.0,   "unit": "gain"},
      "MC_YAWRATE_K":   {"min": 0.5,  "max": 2.0,  "typical": 1.0,   "unit": "gain"}
    },
    "px4_notes": [
      "PX4 的 MC_*RATE_K 是整轴总增益乘子 — P/I/D 比例合适但整体响应弱时优先调 K，而不是同步放大三项",
      "PX4 D 项量级 (~0.003) 用于增加阻尼抑制超调，过高会放大噪声导致电机发热（官方：仅在需要时提高）",
      "PX4 官方推荐 parallel form (K=1) 下 I 典型区间 0.3-0.5（当 P≈0.15 时），pitch 的 I 通常略高于 roll",
      "PX4 v1.14+ 推荐先用机载自动调参 (MC_AT_EN) 取得基线，再用日志分析做精修"
    ]
  },

  "experience_rules": {
    "symptom_to_param": {
      "过冲大":      {"primary_action": "提高 MC_*RATE_D", "secondary_action": "适当降低 MC_*RATE_P"},
      "响应慢":      {"primary_action": "提高 MC_*RATE_P 或 MC_*RATE_K", "secondary_action": "检查 IMU_GYRO_CUTOFF 是否过低"},
      "稳态误差":    {"primary_action": "提高 MC_*RATE_I", "secondary_action": "检查 MC_*R_INT_LIM 积分限幅"},
      "高频抖振":    {"primary_action": "降低 MC_*RATE_D", "secondary_action": "降低 IMU_DGYRO_CUTOFF"},
      "外扰恢复慢":  {"primary_action": "提高 MC_*RATE_P", "secondary_action": "适当提高 MC_*RATE_I"}
    },
    "tuning_sequence": {
      "1_filters": "先确认 IMU_GYRO_CUTOFF / IMU_DGYRO_CUTOFF 与振动水平匹配",
      "2_rate_loop": "按 P → D → I 顺序调 rate 环（Acro 模式打杆测试）",
      "3_attitude_loop": "rate 环满意后再调 MC_ROLL_P / MC_PITCH_P 姿态环",
      "4_verify": "验证外扰恢复与全姿态范围表现"
    }
  },

  "param_change_rules": {
    "step_size": {
      "P": {"increment": 0.01,  "max_change_per_step": 0.03},
      "I": {"increment": 0.02,  "max_change_per_step": 0.05},
      "D": {"increment": 0.0005, "max_change_per_step": 0.001},
      "K": {"increment": 0.05,  "max_change_per_step": 0.1}
    },
    "safety_limits": {
      "P_change_per_session": "不超过 ±25%",
      "D_change_per_session": "不超过 ±25%",
      "I_change_per_session": "不超过 ±25%"
    }
  },

  "symptom_rules": [
    {
      "rule_id": "MC_HIGH_OS",
      "symptom": "overshoot",
      "adjust": [{"param": "d", "action": "increase", "factor": 1.10},
                 {"param": "p", "action": "decrease", "factor": 0.90}],
      "reason": "MC 超调量超阈值 - 提高 D 增益以增加阻尼（PX4 官方：D 用于抑制超调），并适当降低 P",
      "confidence": "high"
    },
    {
      "rule_id": "MC_SLOW_RISE",
      "symptom": "rise_time",
      "adjust": [{"param": "p", "action": "increase", "factor": 1.15},
                 {"param": "d", "action": "decrease", "factor": 0.95}],
      "reason": "MC 上升时间慢 - 提高 P 增益以加快响应",
      "confidence": "high"
    },
    {
      "rule_id": "MC_OSCILLATION",
      "symptom": "oscillation_count",
      "adjust": [{"param": "p", "action": "decrease", "factor": 0.90},
                 {"param": "d", "action": "increase", "factor": 1.10}],
      "reason": "MC 振荡过多 - 提高 D 增益以增加阻尼",
      "confidence": "medium"
    },
    {
      "rule_id": "MC_LONG_SETTLE",
      "symptom": "settling_time",
      "adjust": [{"param": "i", "action": "increase", "factor": 1.20}],
      "reason": "MC 稳定时间长 - 提高 I 增益以加快收敛",
      "confidence": "medium"
    },
    {
      "rule_id": "MC_SS_ERROR",
      "symptom": "steady_state_error",
      "adjust": [{"param": "i", "action": "increase", "factor": 1.25}],
      "reason": "MC 稳态误差 - 提高 I 增益以消除偏差",
      "confidence": "high"
    },
    {
      "rule_id": "MC_FAST_OSCIL",
      "symptom": "fast_oscillation",
      "adjust": [{"param": "d", "action": "decrease", "factor": 0.80}],
      "reason": "MC 高频振荡 - 降低 D 增益",
      "confidence": "high"
    },
    {
      "rule_id": "MC_WEAK_DAMPING",
      "symptom": "poor_damping",
      "adjust": [{"param": "d", "action": "increase", "factor": 1.15}],
      "reason": "MC 阻尼不足且超调 - 提高 D 增益",
      "confidence": "medium"
    }
  ]
}
